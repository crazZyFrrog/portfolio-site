# Optional override for canonical URLs, sitemap.xml and robots.txt.
VITE_SITE_URL=https://vladislav-levonenko.vercel.app

# Server-only Telegram credentials. Never prefix these with VITE_.
TELEGRAM_BOT_TOKEN=123456789:replace-with-bot-token
TELEGRAM_CHAT_ID=replace-with-chat-id

# Public Web3Forms key. Must use VITE_ so the browser can send email.
VITE_WEB3FORMS_ACCESS_KEY=replace-with-access-key
